@startuml radio-ripper-tag Bausteinsicht
skinparam packageStyle rectangle

package "CLI" {
    [cli.py] as CLI
    [__main__.py] as MAIN
}

package "Services" {
    [processor.py] as PROCESSOR
    [fingerprint.py] as FP <<ABC>>
    [metadata_itunes.py] as META_IT <<ABC>>
    [metadata_musicbrainz.py] as META_MB <<ABC>>
    [lyrics.py] as LYRICS <<ABC>>
    [popularity.py] as POP <<ABC>>
    [tagging.py] as TAGGING <<ABC>>
    [file_utils.py] as FILEUTILS
}

package "Domain" {
    [models.py] as MODELS
}

package "Infrastructure" {
    [config.py] as CONFIG
    [http.py] as HTTP <<ABC>>
    [logging.py] as LOGGING
    [resilience.py] as RESILIENCE
    [errors.py] as ERRORS
}

CLI --> PROCESSOR : erzeugt
CLI --> FP : injiziert
CLI --> META_IT : injiziert
CLI --> META_MB : injiziert
CLI --> TAGGING : injiziert
CLI --> POP : injiziert
CLI --> LYRICS : injiziert
CLI --> HTTP : erzeugt HttpxAsyncClient

PROCESSOR --> FP : ruft auf
PROCESSOR --> META_IT : ruft auf
PROCESSOR --> META_MB : ruft auf
PROCESSOR --> TAGGING : ruft auf
PROCESSOR --> LYRICS : ruft auf
PROCESSOR --> POP : ruft auf
PROCESSOR --> FILEUTILS : nutzt
PROCESSOR --> MODELS : liest/schreibt

FP --> MODELS : erzeugt FingerprintResult
META_IT --> HTTP : HTTP-Calls (iTunes)
META_MB --> HTTP : HTTP-Calls (MusicBrainz, CAA)
LYRICS --> HTTP : HTTP-Calls (LRCLib)
POP --> HTTP : HTTP-Calls (Deezer)
HTTP --> RESILIENCE : retry-Decorator

TAGGING --> MODELS : liest TrackInfo/EnrichedInfo

CONFIG --> ERRORS : wirft

@enduml