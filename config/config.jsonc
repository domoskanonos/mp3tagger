{
  // ── Verzeichnisse ──────────────────────────────────────────────────────────
  //
  // Quellverzeichnis: hier legt der Recorder die rohen MP3s ab.
  "source": "/app/source",
  //
  // Zielverzeichnis: fertig getaggte MP3s werden hier abgelegt (Artist/Album/...).
  "destination": "/app/destination",
  //
  // Arbeitsverzeichnis: Staging-Bereich während der Verarbeitung.
  // Hier liegen auch catalog.db und das Logfile.
  "work_dir": "/app/work",

  // ── Fingerprinting ─────────────────────────────────────────────────────────
  //
  // Minimaler AcoustID-Konfidenzwert (0.0–1.0). Dateien unter diesem Wert
  // werden verworfen. Radio-Rips (komprimiert, mit Jingle/Moderation) scoren
  // oft nur 0.70–0.84 — korrekte Treffer gingen bei 0.85 verloren. 0.75 ist
  // ein guter Kompromiss aus Trefferquote und Fehlmatch-Schutz.
  "acoustid_min_score": 0.90,

  // ── Popularität ────────────────────────────────────────────────────────────
  //
  // Minimaler Deezer-Popularitätsrang. Songs mit einem Rang unterhalb dieses
  // Wertes werden gelöscht (je größer der Wert, desto strenger der Filter).
  // 0 = deaktiviert, alle Songs werden akzeptiert.
  "min_popularity_rank": 100000,

  // ── Metadaten & Cover ──────────────────────────────────────────────────────
  //
  // HTTP-Timeout für Metadaten-Anfragen (iTunes, MusicBrainz) in Sekunden.
  "metadata_timeout": 8.0,
  //
  // HTTP-Timeout für Cover-Downloads (Deezer, Cover Art Archive) in Sekunden.
  "cover_timeout": 15.0,

  // ── Parallelität ───────────────────────────────────────────────────────────
  //
  // Puffer-Obergrenze für gleichzeitig verarbeitete Dateien (nicht erzwungen —
  // neue Dateien werden mit 1s Abstand gestartet, bis dieser Wert erreicht ist).
  "max_concurrent": 4,

  // ── Logging ────────────────────────────────────────────────────────────────
  //
  // Log-Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
  "log_level": "INFO",

  // ── Katalog & Sammlung ─────────────────────────────────────────────────────
  //
  // Beim Start: Katalog (SQLite) mit dem Dateisystem abgleichen.
  // Verwaiste DB-Einträge werden entfernt, neue Dateien im Zielverzeichnis
  // werden in den Katalog aufgenommen.
  "reconcile_on_startup": true,
  //
  // Nach dem Reconcile fehlende Tags/Cover (Album, Genre, Cover, recording_id)
  // in Bestandsdateien vervollständigen — gleicher Anreicherungs-Flow wie bei
  // neuen MP3s. Nur Dateien mit fehlenden Feldern werden verarbeitet.
  "enrich_missing_tags_on_startup": false,
  //
  // Strikte Dateinamen-Normierung nach dem Enrich: Dateiname muss mit den
  // artist/title-Tags übereinstimmen (Tag = Wahrheit). Fehlbenannte Dateien
  // werden umbenannt/verschoben (inkl. Album-Ordner). Kein API-Call — rein lokal.
  "tag_filename_compare": false,
  //
  // Maximale Sammlungsgröße in Anzahl Songs. 0 = unbegrenzt.
  // Wenn das Limit erreicht ist und enable_eviction aktiv ist, wird der
  // unpopulärste Song verdrängt.
  "max_collection_size": 75000,
  //
  // Eviction: wenn true und max_collection_size > 0, wird bei vollem Limit
  // automatisch der unpopulärste Song gelöscht um Platz für den neuen zu machen.
  "enable_eviction": false
}
